#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Test files
tmp*

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

#builded binary name
internship_tasks

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# log files
logs.json

# Editor/IDE
# .idea/
# .vscode/
